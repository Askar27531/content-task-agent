    {
      "tool_call_id": "bc818496-1a56-4bd8-b7f9-f8bc544b50f2",
      "run_id": "716b86c5-aa68-44ad-8e6a-9f42e1185868",
      "step_id": "b7242e0c-0798-45a5-9e56-de91b364a2c7",
      "tool_name": "load_skill",
